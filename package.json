    "circular:check":"madge --circular --extensions ts,tsx app src",
    "circular:check:app":"madge --circular --extensions ts,tsx app",
    "circular:check:src":"madge --circular --extensions ts,tsx src",
    "supabase:types":"supabase gen types typescript --project-id mauhdrdnlrvjkekxencu > src/types/database.types.ts",
    "e2e:test":"maestro test e2e/maestro/flows",
    "e2e:test:smoke":"maestro test e2e/maestro/config/test-suites.yaml --suite smoke"
  },
